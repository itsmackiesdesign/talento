{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	# Telegram delivers updates here; it requires a publicly valid certificate, which Caddy
	# provisions automatically for {$DOMAIN}.
	handle /webhook/* {
		reverse_proxy api:8000
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /files/* {
		reverse_proxy api:8000
	}

	handle /health {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:80
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
