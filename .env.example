# ---------------------------------------------------------------- general
ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# Public HTTPS origin of the API. Telegram calls {BASE_URL}/webhook/... so during local
# development this MUST be a tunnel, not localhost:
#   ngrok http 8000        ->  BASE_URL=https://<id>.ngrok-free.app
#   cloudflared tunnel --url http://localhost:8000
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

# ---------------------------------------------------------------- database
DATABASE_URL=postgresql+asyncpg://talento:talento@localhost:5432/talento
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- auth
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------- encryption
# Bot tokens are stored AES-256-GCM encrypted with this key. Rotating it makes every
# already-stored bot token undecryptable, so treat it as permanent per environment.
# Generate: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
BOT_TOKEN_ENCRYPTION_KEY=change-me

# ---------------------------------------------------------------- platform bot
# Separate service bot used to notify HR about new applications and to run the
# /link {code} account-linking flow. Optional — without it the panel simply hides
# the Telegram notification section.
PLATFORM_BOT_TOKEN=
PLATFORM_BOT_USERNAME=

# ---------------------------------------------------------------- files
# Leave the S3_* values empty to store candidate files on local disk instead (dev only).
S3_ENDPOINT_URL=
S3_BUCKET=talento
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PUBLIC_URL=
LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------- observability
SENTRY_DSN=
